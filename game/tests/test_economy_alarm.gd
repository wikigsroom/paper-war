extends SceneTree
const Data=preload("res://scripts/data_store.gd")
const Simulation=preload("res://scripts/battle_sim.gd")
const MatchProjection=preload("res://scripts/match_projection.gd")
const View=preload("res://scripts/battle_view.gd")
const Audio=preload("res://scripts/audio_controller.gd")
var checks: int=0
var failures: Array=[]
func check(ok: bool,note: String):
	checks+=1
	if not ok:failures.append(note)
func alarms(s) -> Array:return s.drain_events().filter(func(e):return e.kind=="economy_alarm")
func _initialize():call_deferred("run")
func run():
	var s=Simulation.new(Data.new());s.start({"map":"map.01.01","faction":"yin","enemy":"mo"})
	s.ai_enabled=[false,false];s.units.clear();s.drain_events()
	var worker=s.spawn("unit.yin.worker",0,20)
	s.damage(worker,1,1,false)
	var first: Array=alarms(s)
	check(first.size()==1,"First real worker damage creates an alarm")
	check(first[0].observer==0 and first[0].side==0,"Alarm belongs to damaged worker owner")
	check(not first[0].has("source_uid") and not first[0].has("id"),"Alarm contains no enemy identity")
	s.damage(worker,1,1,false);check(alarms(s).is_empty(),"Same-time repeat is throttled")
	s.damage(worker,1,0,false);check(alarms(s).is_empty(),"Friendly rejected damage cannot alarm")
	s.damage(worker,0,1,false);check(alarms(s).is_empty(),"Zero damage cannot alarm")
	s.time=7.999;s.damage(worker,1,1,false);check(alarms(s).is_empty(),"Cooldown applies before deadline")
	s.time=8;s.damage(worker,1,1,false);check(alarms(s).size()==1,"Renewed pressure alarms at exact deadline")
	var east=s.spawn("unit.mo.worker",1,28);s.damage(east,1,0,false)
	var east_events: Array=alarms(s)
	check(east_events.size()==1 and east_events[0].observer==1,"Both sides have independent cooldowns")
	check(MatchProjection.visible_events(s,0,east_events).is_empty(),"Other owner alarm is not transported")
	var soldier=s.spawn("unit.yin.axe",0,20);s.time=20;s.damage(soldier,1,1,false)
	check(alarms(s).is_empty(),"Ordinary army damage is not an economic alarm")
	s.set_status(worker,"protect",2);s.damage(worker,1,1,false)
	check(alarms(s).is_empty(),"Blocked damage cannot alarm")
	var fatal=Simulation.new(Data.new());fatal.start({"map":"map.01.01","faction":"yin","enemy":"mo"})
	fatal.units.clear();fatal.drain_events();worker=fatal.spawn("unit.yin.worker",0,20)
	fatal.visibility.refresh();fatal.damage(worker,10000,1,false);var final_events: Array=alarms(fatal);fatal.visibility.refresh()
	check(not fatal.location_visible(0,float(final_events[0].x),float(final_events[0].y)),"Fatal hit removes the last local sight source")
	check(fatal.event_visible(0,final_events[0]),"Owner still knows its fatal economic incident")
	check(not fatal.event_visible(1,final_events[0]),"Opponent cannot receive private alarm even near incident")
	check(MatchProjection.visible_events(fatal,0,final_events).size()==1,"Network delivers owned fatal incident after retreat of fog")
	var view=View.new();view.db=fatal.db;root.add_child(view);view.reset(fatal)
	view.on_event(final_events[0]);check(not view.economy_warning.is_empty(),"Minimap marker accepts owned fatal incident")
	view.camera_x=35;view.target_camera=35;view.selected_spell="spell.yin.lightning"
	view.on_event(final_events[0]);check(view.target_camera==35 and view.selected_spell=="spell.yin.lightning","Warning does not move camera or cancel aiming")
	view.update(3,true);check(view.economy_warning.left==6,"Pause freezes warning lifetime")
	view.update(6,false);check(view.economy_warning.is_empty(),"Warning expires after six active seconds")
	view.on_event(east_events[0]);check(view.economy_warning.is_empty(),"View rejects the other player's alarm")
	view.on_event(final_events[0]);view.reset(fatal);check(view.economy_warning.is_empty(),"New view resets incident state")
	var sound=Audio.new();sound.current_time=10
	sound.battle_event(final_events[0],100)
	check(sound.clocks.get("danger",-1)==10,"Alarm audio dispatch is not suppressed outside the camera")
	sound.background=true;sound.current_time=20;sound.battle_event(final_events[0],100)
	check(sound.clocks.get("danger",-1)==10,"Background audio remains muted")
	sound.free()
	view.queue_free()
	print("ECONOMY_ALARM: ",checks," checks; failures=",failures)
	quit(0 if failures.is_empty() else 1)
